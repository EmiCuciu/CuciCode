{
  "name": "cucicode",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop UI for Claude Code that makes an agentic workflow visible and controllable",
  "workspaces": [
    "packages/*",
    "sidecar",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:plugin",
    "build:sidecar": "npm run build --workspace sidecar",
    "build:app": "npm run tauri build --workspace apps/desktop",
    "dev":"npm run tauri dev --workspace apps/desktop",
    "test:plugin": "node --test plugin/cucicode/hooks/paths.test.mjs plugin/cucicode/hooks/rules.test.mjs plugin/cucicode/hooks/commands.test.mjs"
  }
}
