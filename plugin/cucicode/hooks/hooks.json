{
  "description": "Blocks edits to paths the project marks as protected in .claude/cucicode/settings.json (git.protectedPaths).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-paths.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
